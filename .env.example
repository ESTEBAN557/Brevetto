# ============================================================================
# Brevetto - Variables de entorno (copiar a .env). Valores SOLO para desarrollo.
# ============================================================================

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL 16 ----------------------------------------------------------
POSTGRES_DB=brevetto
POSTGRES_USER=brevetto
POSTGRES_PASSWORD=brevetto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis 7 / Celery -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3 -------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=brevetto-docs
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
PRESIGNED_URL_EXPIRATION_SECONDS=900

# --- Google Gemini ----------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
AI_CONFIDENCE_THRESHOLD=0.85

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
