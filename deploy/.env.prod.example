# ============================================================================
# Brevetto — variables de PRODUCCIÓN. Copiar a la raíz del repo como .env.prod
#   cp deploy/.env.prod.example .env.prod && nano .env.prod
# .env.prod está ignorado por git: NUNCA lo suba al repositorio.
# ============================================================================

# Dominio público SIN https:// ni barra final.
# Sin dominio propio use la IP estática de la VM con guiones + .sslip.io, ej: 34-120-45-67.sslip.io
BREVETTO_DOMAIN=34-120-45-67.sslip.io

# Genere valores largos y aleatorios, por ejemplo con:  openssl rand -base64 48 | tr -d '\n/+='
DJANGO_SECRET_KEY=cambie-esto-por-un-valor-largo-y-aleatorio
POSTGRES_PASSWORD=cambie-esta-contrasena
MINIO_ROOT_USER=brevetto-storage
MINIO_ROOT_PASSWORD=cambie-esta-contrasena-de-almacenamiento

# Google Gemini (https://aistudio.google.com/apikey). Sin clave, los documentos pasan a revisión humana.
GEMINI_API_KEY=

# Correo SMTP para los códigos de acceso de clientes y avisos de requerimientos.
# Ejemplo Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=<cuenta>, EMAIL_HOST_PASSWORD=<contraseña de aplicación>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Brevetto Coltebienes <no-reply@brevetto.local>

# Modo demostración: muestra en pantalla el código de acceso del cliente (no hay proveedor de SMS).
# Útil para la sustentación. Déjelo en False cuando el correo SMTP esté configurado.
CLIENT_OTP_DEV_ECHO=True
